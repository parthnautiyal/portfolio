# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# GitHub Webhook Configuration
# Secret for validating webhook signatures
# Generate a random secret: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# GitHub Portfolio Topic Filter
# Only repos with this topic will be added to portfolio
GITHUB_PORTFOLIO_TOPIC=portfolio-project

# Spring Boot Configuration (optional - defaults work for development)
# SERVER_PORT=8080
# SPRING_PROFILES_ACTIVE=dev
